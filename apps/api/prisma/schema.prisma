generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  HR_MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  GRACE_LATE
  SHORT_LEAVE
  EARLY_DEPARTURE
  HALF_DAY
  FULL_DAY_LEAVE
  ON_LEAVE
  HOLIDAY
}

enum AttendanceMethod {
  WEB
  MOBILE
  FINGERPRINT
  MANUAL
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum PerformancePeriod {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum PerformanceStatus {
  DRAFT
  COMPLETED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnnouncementAudience {
  ALL
  SUPER_ADMIN
  HR_MANAGER
  EMPLOYEE
}

enum JobOpeningStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum CvAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum HiringRecommendation {
  HIGHLY_RECOMMENDED
  RECOMMENDED
  CONSIDER
  NOT_RECOMMENDED
}

model User {
  id String @id @default(cuid())

  email String @unique

  passwordHash String? @map("password")

  role   UserRole   @default(EMPLOYEE)
  status UserStatus @default(ACTIVE)

  employee Employee?

  reviewedLeaveRequests LeaveRequest[] @relation("LeaveRequestReviewer")
  announcementsCreated  Announcement[]

  jobOpeningsCreated JobOpening[] @relation("JobOpeningCreator")
  candidatesCreated  Candidate[]  @relation("CandidateCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
}

model Department {
  id String @id @default(cuid())

  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  positions   Position[]
  employees   Employee[]
  jobOpenings JobOpening[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Position {
  id String @id @default(cuid())

  title       String
  description String?
  isActive    Boolean @default(true)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  employees   Employee[]
  jobOpenings JobOpening[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([title])
}

model Employee {
  id String @id @default(cuid())

  employeeNumber String @unique

  firstName String
  lastName  String
  email     String?   @unique
  phone     String?
  hireDate  DateTime?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  positionId String?
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  attendances      Attendance[]
  shiftAssignments EmployeeShiftAssignment[]
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  salaryProfile    SalaryProfile?
  payrolls         Payroll[]

  performanceReviews        PerformanceReview[] @relation("PerformanceReviewEmployee")
  performanceReviewsCreated PerformanceReview[] @relation("PerformanceReviewCreator")

  candidateSubmissions Candidate[] @relation("EmployeeCandidateSubmissions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([departmentId])
  @@index([positionId])
  @@index([employeeNumber])
  @@index([isActive])
}

model Attendance {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  date DateTime

  scheduledStart DateTime?
  scheduledEnd   DateTime?

  checkIn  DateTime?
  checkOut DateTime?

  status AttendanceStatus @default(PRESENT)
  method AttendanceMethod @default(WEB)

  workingMinutes    Int @default(0)
  lateMinutes       Int @default(0)
  overtimeMinutes   Int @default(0)
  earlyLeaveMinutes Int @default(0)
  shortLeaveMinutes Int @default(0)

  leaveDayValue Decimal @default(0) @db.Decimal(4, 2)

  notes String?

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([shiftId])
  @@index([date])
  @@index([status])
  @@index([method])
}

model AttendanceSettings {
  id String @id @default(cuid())

  officeStartTime String @default("09:00")
  officeEndTime   String @default("17:00")

  gracePeriodMinutes Int @default(10)
  halfDayMinutes     Int @default(240)
  fullDayMinutes     Int @default(480)

  allowWebCheckIn    Boolean @default(true)
  allowMobileCheckIn Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveType {
  id String @id @default(cuid())

  name        String  @unique
  description String?
  defaultDays Decimal @default(0) @db.Decimal(6, 2)
  isActive    Boolean @default(true)

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model LeaveBalance {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  year Int

  allocatedDays Decimal @default(0) @db.Decimal(6, 2)
  usedDays      Decimal @default(0) @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  startDate DateTime
  endDate   DateTime

  totalDays Decimal @db.Decimal(6, 2)
  reason    String

  status LeaveRequestStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?   @relation("LeaveRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewComment String?
  reviewedAt    DateTime?
  cancelledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([reviewedById])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model SalaryProfile {
  id String @id @default(cuid())

  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  basicSalary    Decimal @db.Decimal(12, 2)
  fixedAllowance Decimal @default(0) @db.Decimal(12, 2)
  fixedDeduction Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

model Payroll {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  year  Int
  month Int

  basicSalary Decimal @db.Decimal(12, 2)
  allowances  Decimal @default(0) @db.Decimal(12, 2)
  deductions  Decimal @default(0) @db.Decimal(12, 2)
  grossSalary Decimal @db.Decimal(12, 2)
  netSalary   Decimal @db.Decimal(12, 2)

  status PayrollStatus @default(DRAFT)

  approvedAt DateTime?
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, year, month])
  @@index([employeeId])
  @@index([year, month])
  @@index([status])
}

model PerformanceReview {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation("PerformanceReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   Employee? @relation("PerformanceReviewCreator", fields: [createdById], references: [id], onDelete: SetNull)

  title      String
  reviewDate DateTime
  period     PerformancePeriod
  status     PerformanceStatus @default(DRAFT)

  productivityScore  Int
  qualityScore       Int
  teamworkScore      Int
  attendanceScore    Int
  communicationScore Int

  overallScore Decimal @db.Decimal(5, 2)

  strengths        String?
  improvements     String?
  reviewerComments String?
  employeeComments String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([createdById])
  @@index([reviewDate])
  @@index([period])
  @@index([status])
}

model Announcement {
  id String @id @default(cuid())

  title   String
  content String

  status   AnnouncementStatus   @default(DRAFT)
  audience AnnouncementAudience @default(ALL)

  isPinned Boolean @default(false)

  publishAt DateTime?
  expiresAt DateTime?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([status])
  @@index([audience])
  @@index([isPinned])
  @@index([publishAt])
  @@index([expiresAt])
}

model JobOpening {
  id String @id @default(cuid())

  title       String
  description String

  employmentType EmploymentType   @default(FULL_TIME)
  status         JobOpeningStatus @default(DRAFT)

  numberOfVacancies Int @default(1)
  minimumExperience Int @default(0)

  requiredSkills   String?
  responsibilities String?
  requirements     String?

  salaryMin Decimal? @db.Decimal(12, 2)
  salaryMax Decimal? @db.Decimal(12, 2)

  location String?

  applicationDeadline DateTime?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  positionId String?
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("JobOpeningCreator", fields: [createdById], references: [id], onDelete: Restrict)

  candidates Candidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([positionId])
  @@index([createdById])
  @@index([status])
  @@index([employmentType])
  @@index([applicationDeadline])
  @@index([title])
}

model Candidate {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email String
  phone String?

  currentJobTitle String?
  currentCompany  String?

  yearsOfExperience Decimal @default(0) @db.Decimal(5, 2)

  skills String?

  education String?
  address   String?

  resumeFileName   String?
  resumeUrl        String?
  resumeMimeType   String?
  resumeSizeBytes  Int?
  resumeUploadedAt DateTime?

  linkedInUrl  String?
  portfolioUrl String?

  stage CandidateStage @default(APPLIED)

  notes String?

  appliedAt DateTime @default(now())

  isSelfSubmitted Boolean @default(false)

  submittedByEmployeeId String?
  submittedByEmployee   Employee? @relation("EmployeeCandidateSubmissions", fields: [submittedByEmployeeId], references: [id], onDelete: SetNull)

  jobOpeningId String
  jobOpening   JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CandidateCreator", fields: [createdById], references: [id], onDelete: Restrict)

  cvAnalysis CvAnalysis?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobOpeningId])
  @@index([createdById])
  @@index([submittedByEmployeeId])
  @@index([isSelfSubmitted])
  @@index([stage])
  @@index([email])
  @@index([firstName, lastName])
  @@index([appliedAt])
}

model CvAnalysis {
  id String @id @default(cuid())

  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  status CvAnalysisStatus @default(PENDING)

  extractedText String?

  extractedName       String?
  extractedEmail      String?
  extractedPhone      String?
  extractedJobTitle   String?
  extractedEducation  String?
  extractedExperience String?
  extractedSkills     Json?

  localMatchScore Decimal? @db.Decimal(5, 2)
  aiMatchScore    Decimal? @db.Decimal(5, 2)
  finalMatchScore Decimal? @db.Decimal(5, 2)

  skillsScore       Decimal? @db.Decimal(5, 2)
  experienceScore   Decimal? @db.Decimal(5, 2)
  jobTitleScore     Decimal? @db.Decimal(5, 2)
  educationScore    Decimal? @db.Decimal(5, 2)
  completenessScore Decimal? @db.Decimal(5, 2)

  summary String?

  matchedSkills      Json?
  missingSkills      Json?
  strengths          Json?
  concerns           Json?
  interviewQuestions Json?

  recommendation HiringRecommendation?

  recommendedSalaryMin    Decimal? @db.Decimal(12, 2)
  recommendedSalaryTarget Decimal? @db.Decimal(12, 2)
  recommendedSalaryMax    Decimal? @db.Decimal(12, 2)

  salaryRecommendationReason String?

  modelUsed String?

  errorMessage String?
  analyzedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([finalMatchScore])
  @@index([recommendation])
  @@index([analyzedAt])
}

model Shift {
  id String @id @default(cuid())

  name String
  code String @unique

  startTimeMinutes Int
  endTimeMinutes   Int

  crossesMidnight Boolean @default(false)

  graceMinutes        Int @default(10)
  requiredWorkMinutes Int @default(480)

  isActive Boolean @default(true)

  assignments EmployeeShiftAssignment[]
  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([name])
}

model EmployeeShiftAssignment {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  isActive Boolean @default(true)

  assignedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([shiftId])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@index([isActive])
}

model AttendancePolicy {
  id String @id @default(cuid())

  monthlyShortLeaveCount   Int @default(2)
  monthlyShortLeaveMinutes Int @default(180)

  fullDayMinimumWorkMinutes Int @default(240)
  halfDayMinimumWorkMinutes Int @default(420)

  allowWebCheckIn    Boolean @default(true)
  allowMobileCheckIn Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
